{
  "name": "navidrome-upcoming-releases-plugin",
  "author": "navidrome-upcoming-releases-plugin contributors",
  "version": "0.8.1",
  "description": "Upcoming music releases with an offline list/calendar dashboard, .ics export, optional ntfy alerts and CalDAV or Google Calendar sync.",
  "permissions": {
    "storage": {
      "reason": "Save resumable release checks and the local HTML dashboard"
    },
    "scheduler": {
      "reason": "Refresh library daily and check release pages in short steps"
    },
    "users": {
      "reason": "Read library artists as the user selected from granted access"
    },
    "library": {
      "reason": "Read assigned library metadata; reports stay in private plugin storage"
    },
    "subsonicapi": {
      "reason": "Read scoped artists, album credits and track credits internally"
    },
    "http": {
      "reason": "Fetch MusicBrainz metadata, optional cover thumbnails, and configured notifications or calendar updates.",
      "requiredHosts": [
        "musicbrainz.org",
        "ntfy.sh",
        "www.googleapis.com",
        "oauth2.googleapis.com",
        "caldav.icloud.com",
        "*.icloud.com",
        "coverartarchive.org",
        "archive.org",
        "*.archive.org"
      ]
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "ahead_days": {
          "type": "integer",
          "title": "Days ahead",
          "default": 90,
          "minimum": 1,
          "maximum": 730
        },
        "past_days": {
          "type": "integer",
          "title": "Days back",
          "default": 30,
          "minimum": 0,
          "maximum": 365
        },
        "include_singles": {
          "type": "boolean",
          "title": "Singles",
          "default": false
        },
        "auto_match": {
          "type": "boolean",
          "title": "Match artists without IDs",
          "default": true,
          "description": "Use cautious exact-name matching. Add an override when an artist is ambiguous."
        },
        "artist_overrides": {
          "type": "string",
          "title": "Artist ID overrides",
          "default": "{}",
          "description": "JSON object mapping Navidrome artist IDs to MusicBrainz artist UUIDs."
        },
        "excluded_artists": {
          "type": "string",
          "title": "Excluded artist IDs",
          "default": "[]",
          "description": "JSON array of Navidrome artist IDs to skip."
        },
        "calendar_namespace": {
          "type": "string",
          "title": "Instance name",
          "default": "navidrome-upcoming-releases-plugin",
          "description": "Use a unique name for each installation syncing to a shared calendar. Changing this leaves old events in place."
        },
        "ntfy_server": {
          "type": "string",
          "title": "ntfy server",
          "default": "https://ntfy.sh"
        },
        "ntfy_topic": {
          "type": "string",
          "title": "Topic",
          "default": "",
          "description": "Subscribe to this exact topic in your ntfy app. Treat public topic names as access secrets."
        },
        "ntfy_access_token": {
          "type": "string",
          "title": "ntfy access token",
          "default": ""
        },
        "ntfy_notify_initial": {
          "type": "boolean",
          "title": "Notify about existing releases",
          "default": false,
          "description": "Include the initial backlog when Newly found releases is selected. Otherwise the first scan is silent."
        },
        "calendar_provider": {
          "type": "string",
          "title": "Calendar service",
          "enum": [
            "none",
            "caldav",
            "google"
          ],
          "default": "none",
          "description": "Optional. Select none to disable remote calendar sync; local calendar export still works."
        },
        "caldav_calendar_url": {
          "type": "string",
          "title": "Calendar collection URL",
          "default": "",
          "description": "Full writable HTTPS calendar URL, not the account discovery URL."
        },
        "caldav_username": {
          "type": "string",
          "title": "CalDAV username",
          "default": ""
        },
        "caldav_app_password": {
          "type": "string",
          "title": "CalDAV app password",
          "default": ""
        },
        "google_calendar_id": {
          "type": "string",
          "title": "Calendar ID",
          "default": "",
          "description": "Use the ID of a dedicated writable calendar, not its sharing URL."
        },
        "google_client_id": {
          "type": "string",
          "title": "OAuth client ID",
          "default": "",
          "description": "Desktop OAuth client ID from your Google project."
        },
        "google_client_secret": {
          "type": "string",
          "title": "OAuth client secret",
          "default": "",
          "description": "Keep this private. Use the local authorization helper to obtain credentials."
        },
        "google_refresh_token": {
          "type": "string",
          "title": "OAuth refresh token",
          "default": "",
          "description": "Obtained using scripts/google_authorize.py. Never included in HTML or calendar files."
        },
        "include_albums": {
          "type": "boolean",
          "title": "Albums",
          "default": true
        },
        "include_eps": {
          "type": "boolean",
          "title": "EPs",
          "default": true
        },
        "include_broadcasts": {
          "type": "boolean",
          "title": "Broadcasts",
          "default": false
        },
        "include_other": {
          "type": "boolean",
          "title": "Other or unspecified types",
          "default": false
        },
        "include_standard": {
          "type": "boolean",
          "title": "Standard releases",
          "default": true,
          "description": "Include releases with no secondary tag, such as studio albums and regular singles."
        },
        "include_live": {
          "type": "boolean",
          "title": "Live",
          "default": false
        },
        "include_compilations": {
          "type": "boolean",
          "title": "Compilations",
          "default": false
        },
        "include_remixes": {
          "type": "boolean",
          "title": "Remixes",
          "default": false
        },
        "include_soundtracks": {
          "type": "boolean",
          "title": "Soundtracks",
          "default": false
        },
        "include_demos": {
          "type": "boolean",
          "title": "Demos",
          "default": false
        },
        "include_mixtapes": {
          "type": "boolean",
          "title": "Mixtapes / street releases",
          "default": false
        },
        "include_dj_mixes": {
          "type": "boolean",
          "title": "DJ mixes",
          "default": false
        },
        "include_spokenword": {
          "type": "boolean",
          "title": "Spoken word",
          "default": false
        },
        "include_interviews": {
          "type": "boolean",
          "title": "Interviews",
          "default": false
        },
        "include_audiobooks": {
          "type": "boolean",
          "title": "Audiobooks",
          "default": false
        },
        "include_audio_drama": {
          "type": "boolean",
          "title": "Audio drama",
          "default": false
        },
        "include_field_recordings": {
          "type": "boolean",
          "title": "Field recordings",
          "default": false
        },
        "cover_art": {
          "type": "boolean",
          "title": "Download cover art",
          "default": false,
          "description": "Fetch small Cover Art Archive thumbnails and embed them in the offline HTML. Adds network requests, a private cache and larger reports. Missing covers are skipped."
        },
        "manual_refresh": {
          "type": "boolean",
          "title": "Refresh releases",
          "default": false,
          "description": "Change either way and Save to request a new check. The switch position is not an enabled/disabled state."
        },
        "exclude_owned": {
          "type": "boolean",
          "title": "Exclude releases already in library",
          "default": false,
          "description": "Hide releases matching an album in your selected libraries."
        },
        "exclude_uncredited": {
          "type": "boolean",
          "title": "Exclude artists without directly credited music",
          "default": false,
          "description": "Skip artists with no album or track credited to their own name in the selected libraries."
        },
        "dashboard_theme": {
          "type": "string",
          "title": "Dashboard theme",
          "enum": [
            "bright",
            "dark",
            "black"
          ],
          "default": "dark",
          "description": "Changes only the generated HTML colors. Refresh or copy the report after saving."
        },
        "ntfy_enabled": {
          "type": "boolean",
          "title": "Enable ntfy notifications",
          "default": false,
          "description": "Turn alerts on or off without clearing your topic or credentials."
        },
        "ntfy_notify_new": {
          "type": "boolean",
          "title": "Newly found releases",
          "default": true,
          "description": "Notify when a release first appears in your selected report window."
        },
        "ntfy_notify_updates": {
          "type": "boolean",
          "title": "Changed release details",
          "default": true,
          "description": "Notify when a known release changes its date, title or other reported details."
        },
        "ntfy_notify_release_day": {
          "type": "boolean",
          "title": "Release-day reminders",
          "default": false,
          "description": "Notify once per release date, in UTC. Requires the plugin to run on that day."
        }
      }
    },
    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Info",
          "elements": [
            {
              "type": "Label",
              "text": "Find upcoming and recent releases from your library. Checks refresh daily and resume after restarts."
            },
            {
              "type": "Label",
              "text": "\u00a0"
            },
            {
              "type": "Label",
              "text": "Open upcoming-releases.html from plugin storage in a browser. Refresh or copy a new version to see updates; MusicBrainz links need internet."
            },
            {
              "type": "Label",
              "text": "\u00a0"
            },
            {
              "type": "Label",
              "text": "General controls appearance and library filters; Integrations contains alerts and calendars. Keep working JSON files private."
            },
            {
              "type": "Label",
              "text": "\u00a0"
            },
            {
              "type": "Control",
              "scope": "#/properties/manual_refresh",
              "options": {
                "toggle": true
              }
            }
          ]
        },
        {
          "type": "Categorization",
          "label": "Plugin settings",
          "elements": [
            {
              "type": "Category",
              "label": "General",
              "elements": [
                {
                  "type": "Group",
                  "label": "Date window",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/ahead_days"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/past_days"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Appearance",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Choose Bright, Dark or Black for the HTML report. This changes colors only; your release filters and calendar stay the same."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/dashboard_theme"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/cover_art"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Automatic matching",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "MusicBrainz IDs in your music tags are the most reliable match. Automatic matching is a cautious fallback when tags have no ID."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/auto_match"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Exclusions",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/exclude_owned"
                    },
                    {
                      "type": "Label",
                      "text": "Matches artist and album-title credits exactly, ignoring case and repeated spaces. Release types are checked when tagged; a partial local album still counts as owned."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Applies to reports, notifications and calendars. The local inventory refreshes every 15 minutes and on manual refresh. Differently titled editions may remain visible."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/exclude_uncredited"
                    },
                    {
                      "type": "Label",
                      "text": "Keeps artists with at least one album or track credited to their own name. A split collaboration credit alone does not count."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Checks only the selected libraries, every 15 minutes and on manual refresh. The first scan may take a while. Artist ID overrides do not bypass this filter."
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                }
              ]
            },
            {
              "type": "Category",
              "label": "Releases",
              "elements": [
                {
                  "type": "Group",
                  "label": "Release formats",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/include_albums"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_eps"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_singles"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_broadcasts"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_other"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Standard and special releases",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Choose release formats above. For releases with secondary tags, any selected tag below is enough to include the release."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_standard"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_live"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_compilations"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_remixes"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_soundtracks"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_demos"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_mixtapes"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_dj_mixes"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Spoken and other recordings",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/include_spokenword"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_interviews"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_audiobooks"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_audio_drama"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_field_recordings"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                }
              ]
            },
            {
              "type": "Category",
              "label": "Integrations",
              "elements": [
                {
                  "type": "Group",
                  "label": "ntfy alerts",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Enable ntfy, enter a server and topic, and subscribe to that topic in your ntfy app. Switching alerts off keeps your settings; all alerts follow your General and Releases filters."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_enabled",
                      "options": {
                        "toggle": true
                      }
                    },
                    {
                      "type": "Label",
                      "text": "Use an unguessable topic or a server with restricted read access. Anyone who can read a public topic can see its alerts."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_server"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_topic"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_access_token",
                      "options": {
                        "format": "password"
                      }
                    },
                    {
                      "type": "Label",
                      "text": "Choose what to receive. Release-day reminders use UTC and require a full date; missed days are not replayed."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_notify_new"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_notify_updates"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_notify_release_day"
                    },
                    {
                      "type": "Label",
                      "text": "The first scan is silent unless you include existing releases below. Re-enabling a notification category does not replay changes already skipped."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_notify_initial"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Calendar destination",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Local calendar: use Save or share calendar in the HTML, or import music-releases.ics. Imports are snapshots; select CalDAV or Google for automatic updates to a dedicated calendar."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Select none to stop remote sync; existing remote events stay in place and local export still works. Keep the same instance name and granted user when upgrading to preserve event identities."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/calendar_provider"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/calendar_namespace"
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "CalDAV credentials",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Create a dedicated releases calendar. Enter its full HTTPS collection URL and your provider\u2019s app credentials. An account/discovery URL will not work; redirects are not followed."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/caldav_calendar_url"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/caldav_username"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/caldav_app_password",
                      "options": {
                        "format": "password"
                      }
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/calendar_provider",
                      "schema": {
                        "const": "caldav"
                      }
                    }
                  }
                },
                {
                  "type": "Label",
                  "text": "\u00a0",
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/calendar_provider",
                      "schema": {
                        "const": "caldav"
                      }
                    }
                  }
                },
                {
                  "type": "Group",
                  "label": "Google Calendar credentials",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Create a dedicated Google calendar and copy its Calendar ID. In Google Cloud, enable Calendar API and create an OAuth Desktop client."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Run scripts/google_authorize.py with --client-json client.json --output google-oauth.json on your computer. Authorize the calendar account, then copy the saved credentials below."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "OAuth apps in Testing mode may need periodic reauthorization."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_calendar_id"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_client_id"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_client_secret",
                      "options": {
                        "format": "password"
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_refresh_token",
                      "options": {
                        "format": "password"
                      }
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/calendar_provider",
                      "schema": {
                        "const": "google"
                      }
                    }
                  }
                },
                {
                  "type": "Label",
                  "text": "\u00a0",
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/calendar_provider",
                      "schema": {
                        "const": "google"
                      }
                    }
                  }
                }
              ]
            },
            {
              "type": "Category",
              "label": "Matching",
              "elements": [
                {
                  "type": "Group",
                  "label": "Fix an artist match",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Copy the Navidrome artist ID from the report\u2019s attention section. Find the correct MusicBrainz artist and copy the UUID at the end of its artist-page URL, not a release ID."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Enter a JSON mapping from Navidrome ID to MusicBrainz artist UUID. Example:"
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "{\"artist-id-from-report\":\"11111111-2222-4333-8444-555555555555\"}"
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_overrides",
                      "options": {
                        "multi": true
                      }
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Exclude artists",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Enter Navidrome IDs as a JSON array, for example [\"artist-id-from-report\"]. Save changes to apply matching and exclusion settings."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/excluded_artists",
                      "options": {
                        "multi": true
                      }
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                }
              ]
            }
          ]
        },
        {
          "type": "Group",
          "label": "Library access",
          "elements": [
            {
              "type": "Label",
              "text": "Grant exactly one user in Users Permission and select the intended libraries in Library Permission. Turn off Allow all users when more than one account exists. Library write access is not needed."
            },
            {
              "type": "Label",
              "text": "\u00a0"
            },
            {
              "type": "Label",
              "text": "MusicBrainz lookups need no personal account or email; requests use the plugin\u2019s project identification."
            }
          ]
        }
      ]
    }
  }
}
