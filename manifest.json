                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/calendar_provider",
                      "schema": {
                        "const": "google"
                      }
                    }
                  }
                }
              ]
            },
            {
              "type": "Category",
              "label": "Matching",
              "elements": [
                {
                  "type": "Group",
                  "label": "Fix an artist match",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Open the report\u2019s attention section and copy the Navidrome artist ID shown there."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Find the correct artist on MusicBrainz."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Copy the UUID at the end of its artist-page URL, not a release or release-group ID."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Enter a JSON mapping from Navidrome ID to MusicBrainz artist UUID."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Example:"
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "{\"artist-id-from-report\":\"11111111-2222-4333-8444-555555555555\"}"
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_overrides",
                      "options": {
                        "multi": true
                      }
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                },
                {
                  "type": "Group",
                  "label": "Exclude artists",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Enter Navidrome IDs as a JSON array, for example [\"artist-id-from-report\"]."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Save changes to apply matching and exclusion settings."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/excluded_artists",
                      "options": {
                        "multi": true
                      }
                    }
                  ]
                },
                {
                  "type": "Label",
                  "text": "\u00a0"
                }
              ]
            }
          ]
        },
