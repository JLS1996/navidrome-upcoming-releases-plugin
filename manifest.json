{
  "name": "Release Radar",
  "author": "Release Radar contributors",
  "version": "0.2.4",
  "description": "Upcoming music releases with an offline list/calendar dashboard, .ics export, optional ntfy alerts and CalDAV or Google Calendar sync.",
  "permissions": {
    "storage": {
      "reason": "Save resumable release checks and the local HTML dashboard"
    },
    "scheduler": {
      "reason": "Refresh library daily and check release pages in short steps"
    },
    "users": {
      "reason": "Read library artists as the user selected from granted access"
    },
    "library": {
      "reason": "Read assigned library metadata and optionally export HTML into a library when administrator write access is granted",
      "filesystem": true
    },
    "subsonicapi": {
      "reason": "Read artists and MusicBrainz IDs internally"
    },
    "http": {
      "reason": "Fetch MusicBrainz metadata and optionally publish ntfy notifications or sync a configured calendar.",
      "requiredHosts": [
        "musicbrainz.org",
        "ntfy.sh",
        "www.googleapis.com",
        "oauth2.googleapis.com",
        "caldav.icloud.com",
        "*.icloud.com"
      ]
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "title": "Navidrome username",
          "description": "Optional: leave blank to use the only user granted access. With multiple granted users, choose exactly one in User Access or enter a granted username here.",
          "default": ""
        },
        "contact": {
          "type": "string",
          "title": "MusicBrainz contact",
          "description": "Contact email or project URL used to identify metadata requests. Not included in the report."
        },
        "ahead_days": {
          "type": "integer",
          "title": "Days ahead",
          "default": 90,
          "minimum": 1,
          "maximum": 730
        },
        "past_days": {
          "type": "integer",
          "title": "Days back",
          "default": 30,
          "minimum": 0,
          "maximum": 365
        },
        "include_singles": {
          "type": "boolean",
          "title": "Include singles",
          "default": false
        },
        "include_secondary": {
          "type": "boolean",
          "title": "Include live and compilation releases",
          "default": false,
          "description": "Also includes other secondary release types such as remixes and soundtracks."
        },
        "auto_match": {
          "type": "boolean",
          "title": "Match artists without IDs",
          "default": true,
          "description": "Use cautious exact-name matching. Add an override when an artist is ambiguous."
        },
        "artist_overrides": {
          "type": "string",
          "title": "Artist ID overrides",
          "default": "{}",
          "description": "JSON object mapping Navidrome artist IDs to MusicBrainz artist UUIDs."
        },
        "excluded_artists": {
          "type": "string",
          "title": "Excluded artist IDs",
          "default": "[]",
          "description": "JSON array of Navidrome artist IDs to skip."
        },
        "export_library_id": {
          "type": "integer",
          "title": "Export library ID",
          "default": 0,
          "minimum": 0,
          "description": "0 keeps files in private plugin storage. Another ID exports to that library root and requires write access."
        },
        "refresh_token": {
          "type": "string",
          "title": "Refresh request",
          "default": "",
          "description": "Change this value to request a new release check. This is not an authentication token."
        },
        "calendar_namespace": {
          "type": "string",
          "title": "Instance name",
          "default": "release-radar",
          "description": "Use a unique name for each installation syncing to a shared calendar. Changing this leaves old events in place."
        },
        "ntfy_server": {
          "type": "string",
          "title": "ntfy server",
          "default": "https://ntfy.sh"
        },
        "ntfy_topic": {
          "type": "string",
          "title": "Topic",
          "default": "",
          "description": "Leave blank to disable notifications. Public topics are not private unless the server restricts read access."
        },
        "ntfy_access_token": {
          "type": "string",
          "title": "ntfy access token",
          "default": ""
        },
        "ntfy_notify_initial": {
          "type": "boolean",
          "title": "Notify about existing releases",
          "default": false,
          "description": "Off by default to avoid sending the initial backlog."
        },
        "calendar_provider": {
          "type": "string",
          "title": "Calendar service",
          "enum": [
            "none",
            "caldav",
            "google"
          ],
          "default": "none",
          "description": "Optional. Select none to disable remote calendar sync; local calendar export still works."
        },
        "caldav_calendar_url": {
          "type": "string",
          "title": "Calendar collection URL",
          "default": "",
          "description": "Full writable HTTPS calendar URL, not the account discovery URL."
        },
        "caldav_username": {
          "type": "string",
          "title": "CalDAV username",
          "default": ""
        },
        "caldav_app_password": {
          "type": "string",
          "title": "CalDAV app password",
          "default": ""
        },
        "google_calendar_id": {
          "type": "string",
          "title": "Calendar ID",
          "default": "",
          "description": "Use the ID of a dedicated writable calendar, not its sharing URL."
        },
        "google_client_id": {
          "type": "string",
          "title": "OAuth client ID",
          "default": "",
          "description": "Desktop OAuth client ID from your Google project."
        },
        "google_client_secret": {
          "type": "string",
          "title": "OAuth client secret",
          "default": "",
          "description": "Keep this private. Use the local authorization helper to obtain credentials."
        },
        "google_refresh_token": {
          "type": "string",
          "title": "OAuth refresh token",
          "default": "",
          "description": "Obtained using scripts/google_authorize.py. Never included in HTML or calendar files."
        }
      }
    },
    "uiSchema": {
      "type": "Categorization",
      "label": "Plugin settings",
      "elements": [
        {
          "type": "Category",
          "label": "Library",
          "elements": [
            {
              "type": "Group",
              "label": "Access and identification",
              "elements": [
                {
                  "type": "Label",
                  "text": "Grant one user in User Access to select it automatically. Leave the username blank."
                },
                {
                  "type": "Control",
                  "scope": "#/properties/username"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/contact"
                }
              ]
            },
            {
              "type": "Group",
              "label": "Artist matching",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/auto_match"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/artist_overrides",
                  "options": {
                    "multi": true
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/excluded_artists",
                  "options": {
                    "multi": true
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Releases",
          "elements": [
            {
              "type": "Group",
              "label": "Release window and types",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/ahead_days"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/past_days"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/include_singles"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/include_secondary"
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Local files",
          "elements": [
            {
              "type": "Group",
              "label": "Local report export",
              "elements": [
                {
                  "type": "Label",
                  "text": "Files remain local. This plugin does not expose a web download endpoint."
                },
                {
                  "type": "Control",
                  "scope": "#/properties/export_library_id"
                }
              ]
            },
            {
              "type": "Group",
              "label": "Manual refresh",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/refresh_token"
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Notifications",
          "elements": [
            {
              "type": "Group",
              "label": "ntfy alerts",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/ntfy_server"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/ntfy_topic"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/ntfy_access_token",
                  "options": {
                    "format": "password"
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/ntfy_notify_initial"
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Calendar",
          "elements": [
            {
              "type": "Group",
              "label": "Calendar destination",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/calendar_provider"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/calendar_namespace"
                }
              ]
            },
            {
              "type": "Group",
              "label": "CalDAV credentials",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/caldav_calendar_url"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/caldav_username"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/caldav_app_password",
                  "options": {
                    "format": "password"
                  }
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/calendar_provider",
                  "schema": {
                    "const": "caldav"
                  }
                }
              }
            },
            {
              "type": "Group",
              "label": "Google Calendar credentials",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/google_calendar_id"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/google_client_id"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/google_client_secret",
                  "options": {
                    "format": "password"
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/google_refresh_token",
                  "options": {
                    "format": "password"
                  }
                }
              ],
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/calendar_provider",
                  "schema": {
                    "const": "google"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
