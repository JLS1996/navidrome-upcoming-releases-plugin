            },
            {
              "type": "Label",
              "text": "\u00a0"
            },
            {
              "type": "Label",
              "text": "Select the intended libraries in Library Permission."
            },
            {
              "type": "Label",
              "text": "\u00a0"
            },
            {
              "type": "Label",
              "text": "Turn off Allow all users when more than one account exists."
            },
            {
              "type": "Label",
              "text": "\u00a0"
            },
            {
              "type": "Label",
              "text": "Library write access is not needed."
            },
            {
              "type": "Label",
              "text": "\u00a0"
            },
            {
              "type": "Label",
              "text": "MusicBrainz lookups require no personal account or email."
            },
            {
              "type": "Label",
              "text": "\u00a0"
