                {
                  "type": "Group",
                  "label": "Google Calendar credentials",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Create a dedicated Google calendar and copy its Calendar ID from Google Calendar settings."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "In Google Cloud, enable Calendar API and create an OAuth Desktop client."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "On your computer, run scripts/google_authorize.py with --client-json client.json --output google-oauth.json."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "Authorize the calendar account, then copy the saved client ID, secret and refresh token below."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Label",
                      "text": "OAuth apps in Testing mode may need periodic reauthorization."
                    },
                    {
                      "type": "Label",
                      "text": "\u00a0"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_calendar_id"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_client_id"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_client_secret",
                      "options": {
                        "format": "password"
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_refresh_token",
                      "options": {
                        "format": "password"
                      }
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/calendar_provider",
                      "schema": {
                        "const": "google"
                      }
                    }
                  }
