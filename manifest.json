{
  "name": "Release Radar",
  "author": "Release Radar contributors",
  "version": "0.3.1",
  "description": "Upcoming music releases with an offline list/calendar dashboard, .ics export, optional ntfy alerts and CalDAV or Google Calendar sync.",
  "permissions": {
    "storage": {
      "reason": "Save resumable release checks and the local HTML dashboard"
    },
    "scheduler": {
      "reason": "Refresh library daily and check release pages in short steps"
    },
    "users": {
      "reason": "Read library artists as the user selected from granted access"
    },
    "library": {
      "reason": "Read assigned library metadata; reports stay in private plugin storage"
    },
    "subsonicapi": {
      "reason": "Read artists and MusicBrainz IDs internally"
    },
    "http": {
      "reason": "Fetch MusicBrainz metadata and optionally publish ntfy notifications or sync a configured calendar.",
      "requiredHosts": [
        "musicbrainz.org",
        "ntfy.sh",
        "www.googleapis.com",
        "oauth2.googleapis.com",
        "caldav.icloud.com",
        "*.icloud.com"
      ]
    }
  },
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "ahead_days": {
          "type": "integer",
          "title": "Days ahead",
          "default": 90,
          "minimum": 1,
          "maximum": 730
        },
        "past_days": {
          "type": "integer",
          "title": "Days back",
          "default": 30,
          "minimum": 0,
          "maximum": 365
        },
        "include_singles": {
          "type": "boolean",
          "title": "Singles",
          "default": false
        },
        "auto_match": {
          "type": "boolean",
          "title": "Match artists without IDs",
          "default": true,
          "description": "Use cautious exact-name matching. Add an override when an artist is ambiguous."
        },
        "artist_overrides": {
          "type": "string",
          "title": "Artist ID overrides",
          "default": "{}",
          "description": "JSON object mapping Navidrome artist IDs to MusicBrainz artist UUIDs."
        },
        "excluded_artists": {
          "type": "string",
          "title": "Excluded artist IDs",
          "default": "[]",
          "description": "JSON array of Navidrome artist IDs to skip."
        },
        "refresh_token": {
          "type": "string",
          "title": "Refresh request",
          "default": "",
          "description": "Change this value to request a new release check. This is not an authentication token."
        },
        "calendar_namespace": {
          "type": "string",
          "title": "Instance name",
          "default": "release-radar",
          "description": "Use a unique name for each installation syncing to a shared calendar. Changing this leaves old events in place."
        },
        "ntfy_server": {
          "type": "string",
          "title": "ntfy server",
          "default": "https://ntfy.sh"
        },
        "ntfy_topic": {
          "type": "string",
          "title": "Topic",
          "default": "",
          "description": "Leave blank to disable notifications. Public topics are not private unless the server restricts read access."
        },
        "ntfy_access_token": {
          "type": "string",
          "title": "ntfy access token",
          "default": ""
        },
        "ntfy_notify_initial": {
          "type": "boolean",
          "title": "Notify about existing releases",
          "default": false,
          "description": "Off by default to avoid sending the initial backlog."
        },
        "calendar_provider": {
          "type": "string",
          "title": "Calendar service",
          "enum": [
            "none",
            "caldav",
            "google"
          ],
          "default": "none",
          "description": "Optional. Select none to disable remote calendar sync; local calendar export still works."
        },
        "caldav_calendar_url": {
          "type": "string",
          "title": "Calendar collection URL",
          "default": "",
          "description": "Full writable HTTPS calendar URL, not the account discovery URL."
        },
        "caldav_username": {
          "type": "string",
          "title": "CalDAV username",
          "default": ""
        },
        "caldav_app_password": {
          "type": "string",
          "title": "CalDAV app password",
          "default": ""
        },
        "google_calendar_id": {
          "type": "string",
          "title": "Calendar ID",
          "default": "",
          "description": "Use the ID of a dedicated writable calendar, not its sharing URL."
        },
        "google_client_id": {
          "type": "string",
          "title": "OAuth client ID",
          "default": "",
          "description": "Desktop OAuth client ID from your Google project."
        },
        "google_client_secret": {
          "type": "string",
          "title": "OAuth client secret",
          "default": "",
          "description": "Keep this private. Use the local authorization helper to obtain credentials."
        },
        "google_refresh_token": {
          "type": "string",
          "title": "OAuth refresh token",
          "default": "",
          "description": "Obtained using scripts/google_authorize.py. Never included in HTML or calendar files."
        },
        "include_albums": {
          "type": "boolean",
          "title": "Albums",
          "default": true
        },
        "include_eps": {
          "type": "boolean",
          "title": "EPs",
          "default": true
        },
        "include_broadcasts": {
          "type": "boolean",
          "title": "Broadcasts",
          "default": false
        },
        "include_other": {
          "type": "boolean",
          "title": "Other or unspecified types",
          "default": false
        },
        "include_standard": {
          "type": "boolean",
          "title": "Standard releases",
          "default": true,
          "description": "Include releases with no secondary tag, such as studio albums and regular singles."
        },
        "include_live": {
          "type": "boolean",
          "title": "Live",
          "default": false
        },
        "include_compilations": {
          "type": "boolean",
          "title": "Compilations",
          "default": false
        },
        "include_remixes": {
          "type": "boolean",
          "title": "Remixes",
          "default": false
        },
        "include_soundtracks": {
          "type": "boolean",
          "title": "Soundtracks",
          "default": false
        },
        "include_demos": {
          "type": "boolean",
          "title": "Demos",
          "default": false
        },
        "include_mixtapes": {
          "type": "boolean",
          "title": "Mixtapes / street releases",
          "default": false
        },
        "include_dj_mixes": {
          "type": "boolean",
          "title": "DJ mixes",
          "default": false
        },
        "include_spokenword": {
          "type": "boolean",
          "title": "Spoken word",
          "default": false
        },
        "include_interviews": {
          "type": "boolean",
          "title": "Interviews",
          "default": false
        },
        "include_audiobooks": {
          "type": "boolean",
          "title": "Audiobooks",
          "default": false
        },
        "include_audio_drama": {
          "type": "boolean",
          "title": "Audio drama",
          "default": false
        },
        "include_field_recordings": {
          "type": "boolean",
          "title": "Field recordings",
          "default": false
        }
      }
    },
    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "Generated files",
          "elements": [
            {
              "type": "Label",
              "text": "Reports are saved in Navidrome\u2019s data folder: plugins/release-radar/storage/"
            },
            {
              "type": "Label",
              "text": "Open upcoming-releases.html locally for the release list and calendar. Import music-releases.ics for dated events. Copy the HTML again to see updates on another device."
            },
            {
              "type": "Label",
              "text": "Optional integrations send release information to ntfy and your configured CalDAV or Google Calendar. Local report files stay in plugin storage; no incoming web download endpoint is added."
            },
            {
              "type": "Label",
              "text": "Keep state.json and integrations.json private. They contain library metadata and integration state."
            }
          ]
        },
        {
          "type": "Categorization",
          "label": "Plugin settings",
          "elements": [
            {
              "type": "Category",
              "label": "General",
              "elements": [
                {
                  "type": "Group",
                  "label": "Artist matching",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/auto_match"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/artist_overrides",
                      "options": {
                        "multi": true
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/excluded_artists",
                      "options": {
                        "multi": true
                      }
                    }
                  ]
                },
                {
                  "type": "Group",
                  "label": "Manual refresh",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/refresh_token"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Category",
              "label": "Releases",
              "elements": [
                {
                  "type": "Group",
                  "label": "Date window",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/ahead_days"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/past_days"
                    }
                  ]
                },
                {
                  "type": "Group",
                  "label": "Release formats",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/include_albums"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_eps"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_singles"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_broadcasts"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_other"
                    }
                  ]
                },
                {
                  "type": "Group",
                  "label": "Standard and special releases",
                  "elements": [
                    {
                      "type": "Label",
                      "text": "Choose release formats above. For releases with secondary tags, any selected tag below is enough to include the release."
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_standard"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_live"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_compilations"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_remixes"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_soundtracks"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_demos"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_mixtapes"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_dj_mixes"
                    }
                  ]
                },
                {
                  "type": "Group",
                  "label": "Spoken and other recordings",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/include_spokenword"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_interviews"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_audiobooks"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_audio_drama"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/include_field_recordings"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Category",
              "label": "Notifications",
              "elements": [
                {
                  "type": "Group",
                  "label": "ntfy alerts",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_server"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_topic"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_access_token",
                      "options": {
                        "format": "password"
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/ntfy_notify_initial"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Category",
              "label": "Calendar",
              "elements": [
                {
                  "type": "Group",
                  "label": "Calendar destination",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/calendar_provider"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/calendar_namespace"
                    }
                  ]
                },
                {
                  "type": "Group",
                  "label": "CalDAV credentials",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/caldav_calendar_url"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/caldav_username"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/caldav_app_password",
                      "options": {
                        "format": "password"
                      }
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/calendar_provider",
                      "schema": {
                        "const": "caldav"
                      }
                    }
                  }
                },
                {
                  "type": "Group",
                  "label": "Google Calendar credentials",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/google_calendar_id"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_client_id"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_client_secret",
                      "options": {
                        "format": "password"
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/google_refresh_token",
                      "options": {
                        "format": "password"
                      }
                    }
                  ],
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/calendar_provider",
                      "schema": {
                        "const": "google"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Group",
          "label": "Library access",
          "elements": [
            {
              "type": "Label",
              "text": "Grant exactly one Navidrome user in Users Permission below, and select the intended libraries in Library Permission. Turn off Allow all users when more than one account exists. Library write access is not needed."
            },
            {
              "type": "Label",
              "text": "MusicBrainz lookups require no personal account or email. They use the plugin\u2019s project identification."
            }
          ]
        }
      ]
    }
  }
}
